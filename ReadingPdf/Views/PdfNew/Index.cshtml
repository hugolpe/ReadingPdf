                function onCuentaQBChange(event) {
            const select = event.target;
            const selectedOption = select.options[select.selectedIndex];

            const tipoCuenta = selectedOption.getAttribute('data-tipo');
            const tipoTransaccion = selectedOption.getAttribute('data-tipo-transaccion');
            const listId = selectedOption.getAttribute('data-list-id');

            sessionStorage.setItem('cuentaQB_Tipo', tipoCuenta);
            sessionStorage.setItem('cuentaQB_TipoTransaccion', tipoTransaccion);
            sessionStorage.setItem('cuentaQB_ListID', listId);
            sessionStorage.setItem('cuentaQB_Nombre', selectedOption.value);
        }


