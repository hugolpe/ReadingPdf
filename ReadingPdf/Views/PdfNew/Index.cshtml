                // ===============================
        //  ✅ MODIFICADO: PROCESAR PDFs CON PROGRESO Y CUENTA QB
        // ===============================
        async function procesarPdfsConProgresoReal(form) {
            const formData = new FormData(form);
            const files = document.getElementById('archivosPdf').files;

            if (!files || files.length === 0) {
                alert('Por favor seleccione al menos un archivo PDF.');
                return;
            }

            // Verificar que haya cuenta seleccionada
            const cuentaQB = formData.get('LastSelectedAccountQB');
            if (!cuentaQB) {
                alert('⚠️ Por favor seleccione una Cuenta de QuickBooks antes de procesar.');
                return;
            }

            console.log("🚀 Iniciando procesamiento con cuenta:", cuentaQB);

            showProgressModal('Iniciando procesamiento...', true);
            updateProgressBar(0, 'Subiendo archivos...');

            try {
                // 1) Llamar a StartProcesar
                const response = await fetch('/PdfNew/StartProcesar', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`Error ${response.status}: ${response.statusText}`);
                }

                const data = await response.json();
                const batchId = data.batchId;

                if (!batchId) {
                    throw new Error('No se recibió batchId del servidor');
                }

                console.log('✅ BatchId recibido:', batchId);
                console.log('✅ Cuenta QB para este batch:', cuentaQB);

                // 2) Hacer polling del progreso
                let pollCount = 0;
                const maxPolls = 600;

                const checkProgress = async () => {
                    try {
                        const progressResponse = await fetch(`/PdfNew/GetProgress?batchId=${batchId}`);

                        if (!progressResponse.ok) {
                            console.warn('GetProgress falló:', progressResponse.status);
                            if (pollCount < maxPolls) {
                                pollCount++;
                                setTimeout(checkProgress, 500);
                            } else {
                                throw new Error('Timeout esperando progreso');
                            }
                            return;
                        }

                        const progress = await progressResponse.json();
                        console.log('Progreso:', progress);

                        const percent = progress.percent || 0;
                        let statusText = progress.status || 'Procesando...';

                        if (progress.totalFiles > 0) {
                            statusText += ` (${progress.processedFiles}/${progress.totalFiles} archivos)`;
                        }
                        if (progress.totalMovements > 0) {
                            statusText += ` - ${progress.processedMovements}/${progress.totalMovements} movimientos`;
                        }

                        updateProgressBar(percent, statusText);

                        if (progress.done) {
                            if (progress.status === "Error") {
                                hideProgressModal();
                                alert('Error durante el procesamiento. Por favor revise los archivos.');
                                return;
                            }

                            updateProgressBar(100, '¡Procesamiento completado!');

                            setTimeout(() => {
                                hideProgressModal();
                                // ✅ Pasar la cuenta QB en la URL
                                window.location.href = `/PdfNew/EditTemporal?batchId=${batchId}&selectedAccountQB=${encodeURIComponent(cuentaQB)}`;
                            }, 1000);
                        } else {
                            if (pollCount < maxPolls) {
                                pollCount++;
                                setTimeout(checkProgress, 500);
                            } else {
                                throw new Error('Timeout: el procesamiento tomó demasiado tiempo');
                            }
                        }
                    } catch (err) {
                        console.error('Error en checkProgress:', err);
                        hideProgressModal();
                        alert('Error consultando el progreso: ' + err.message);
                    }
                };

                await checkProgress();

            } catch (error) {
                console.error('Error procesando PDFs:', error);
                hideProgressModal();
                alert('Error al procesar los archivos: ' + error.message);
            }
        }

        function limpiarNombreEmpresa(text) {
            if (!text) return "";
            text = text.replace(/^Empresa:\s*/i, "");
            return text.trim();
        }

        // ===============================
        //  CARGAR EMPRESA DESDE API
        // ===============================
        async function obtenerDatosEmpresaQB() {
            const div = document.getElementById("empresaQB");
            const nameSpan = document.getElementById("empresaQBName");
            const btn = document.getElementById("btnSyncPlan");
            const apiUrl = 'https://localhost:7165/api/quickbooks/empresa';

            showProgressModal('Conectando con QuickBooks...');

            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), 8000);

                const res = await fetch(apiUrl, { signal: controller.signal });
                clearTimeout(timeout);

                if (!res.ok) {
                    nameSpan.textContent = `API returned ${res.status} ${res.statusText}`;
                    div.style.display = "block";
                    btn.style.display = "none";
                    return;
                }

                const data = await res.json();
                let nombre = data?.datos ?? "";
                nombre = limpiarNombreEmpresa(nombre);

                nameSpan.textContent = nombre;
                div.style.display = "block";
                
                if (nombre && nombre.length > 0) {
                    btn.style.display = "inline-block";
                } else {
                    btn.style.display = "none";
                }

            } catch (err) {
                nameSpan.textContent = "Error conectando con QuickBooks API: " + (err.message || err);
                div.style.display = "block";
                btn.style.display = "none";
            } finally {
                hideProgressModal();
            }
        }

