        function showProgressModal(message, showProgress = false) {
            const modal = new bootstrap.Modal(document.getElementById('progressModal'));
            document.getElementById('progressMessage').textContent = message || 'Procesando...';
            
            const progressContainer = document.getElementById('progressBarContainer');
            if (showProgress) {
                progressContainer.style.display = 'block';
                updateProgressBar(0, '');
            } else {
                progressContainer.style.display = 'none';
            }
            
            modal.show();
        }

        function updateProgressBar(percentage, details = '') {
            const progressBar = document.getElementById('progressBar');
            const progressPercentage = document.getElementById('progressPercentage');
            const progressDetails = document.getElementById('progressDetails');
            
            progressBar.style.width = percentage + '%';
            progressBar.setAttribute('aria-valuenow', percentage);
            progressPercentage.textContent = Math.round(percentage) + '%';
            
            if (details) {
                progressDetails.textContent = details;
            }
        }

        function hideProgressModal() {
            const modalEl = document.getElementById('progressModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }
        }

