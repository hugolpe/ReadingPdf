        let cuentasQBData = []; // ✅ Variable global para almacenar datos completos

        async function obtenerCuentasQB() {
            const select = document.getElementById("CuentaQB");
            const div = document.getElementById("cuentasQB");

            try {
                const res = await fetch("https://localhost:7165/api/quickbooks/cuentas-con-tipo");
                const data = await res.json();

                if (!data.success) {
                    throw new Error(data.message || "Error obteniendo cuentas");
                }

                const cuentas = data.cuentas || [];
                cuentasQBData = cuentas; // ✅ Guardar datos completos

                select.innerHTML = '<option value="">-- Seleccione una cuenta --</option>';

                cuentas.forEach(c => {
                    const opt = document.createElement("option");
                    opt.value = c.fullName || c.nombre; // Usar FullName para QB
                    opt.textContent = `${c.nombre} (${c.tipo === 'atBank' ? 'Banco' : 'Tarjeta Crédito'})`;

                    // ✅ Guardar información adicional como data attributes
                    opt.setAttribute('data-tipo', c.tipo);
                    opt.setAttribute('data-tipo-transaccion', c.tipoTransaccion);
                    opt.setAttribute('data-list-id', c.listID || '');
                    opt.setAttribute('data-saldo', c.saldo || 0);

                    select.appendChild(opt);
                });

                div.textContent = `✅ Cuentas cargadas: ${cuentas.length}`;
                div.style.display = "block";

                // ✅ Agregar listener para cuando cambie la selección
                select.addEventListener('change', onCuentaQBChange);

            } catch (err) {
                console.error("Error cargando cuentas:", err);
                div.textContent = "❌ Error cargando cuentas: " + err.message;
                div.style.display = "block";
            }
        }


