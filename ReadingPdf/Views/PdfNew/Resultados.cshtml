@{
    // Build account statistics to drive dropdown suggestions (server-side aggregation)
    var accountStats = Model?
        .GroupBy(m => string.IsNullOrWhiteSpace(m?.CuentaPredicha) ? (m?.CuentaContableAplicada ?? "SIN PREDICCION") : m!.CuentaPredicha!)
        .Select(g => new
        {
            Account = g.Key ?? "",
            Count = g.Count(),
            AvgScore = g.Any(x => x != null) ? (int)Math.Round(g.Average(x => x?.ScorePrediccion ?? 0)) : 0
        })
        .OrderByDescending(x => x.Count)
        .ToList();
    if (accountStats == null)
    {
        // Use an empty list of the same anonymous type as accountStats
        accountStats = new[] { new { Account = "", Count = 0, AvgScore = 0 } }.Take(0).ToList();
    }
}

<div id="server-data"
     data-interest='@Html.Raw(JsonConvert.SerializeObject(ViewBag.LastInterestCharged))'
     data-selected-qb='@Html.Raw(JsonConvert.SerializeObject(Convert.ToString(ViewBag.SelectedCuentaQB) ?? ""))'
     data-account-stats='@Html.Raw(JsonConvert.SerializeObject(accountStats))'
     data-batch-id='@Html.Raw(JsonConvert.SerializeObject(ViewBag.BatchId?.ToString() ?? ""))'
     data-currency='@Html.Raw(JsonConvert.SerializeObject(System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol))'
     data-bankname='@Html.Raw(JsonConvert.SerializeObject(ViewBag.BankName ?? ""))'
     style="display:none;"></div>


@section Scripts {
    <script src="https://kit.fontawesome.com/06c58f1ccc.js" crossorigin="anonymous"></script>

    <!-- Centralized server data helper must be first -->
    <script src="~/js/serverData.js"></script>

    <!-- Cargar archivos JS en orden correcto -->
    <script src="~/js/utils.js"></script>
    <script src="~/js/selection.js"></script>
    <script src="~/js/empresa.js"></script>
    <script src="~/js/sorting.js"></script>
    <script src="~/js/register.js"></script>
    <script src="~/js/qbView.js"></script>
    <script src="~/js/contextMenu.js"></script>
    <script src="~/js/obtenerNombres.js"></script>
    <script src="~/js/main.js"></script>

    <!-- ✅ NUEVO: Script para manejar tipos de documento dinámicos -->
    <script>
        // ===============================
        //  LECTURA CENTRALIZADA DE DATOS DEL SERVIDOR
        // ===============================
        const _serverDataEl = document.getElementById('server-data');
        const _serverBankName = _serverDataEl ? JSON.parse(_serverDataEl.getAttribute('data-bankname') || '""') : "";
        const _serverBatchId = _serverDataEl ? JSON.parse(_serverDataEl.getAttribute('data-batch-id') || '""') : "";
        const _serverSelectedAccountQB = _serverDataEl ? JSON.parse(_serverDataEl.getAttribute('data-selected-qb') || '""') : "";
        const _serverInterestCharged = _serverDataEl ? JSON.parse(_serverDataEl.getAttribute('data-interest') || '0') : 0;

        // ===============================
        //  FUNCIONES PARA TIPOS DE DOCUMENTO DINÁMICOS
        // ===============================

        function esAmex() {
            return (typeof _serverSelectedAccountQB === 'string') &&
                   /amex|american express/i.test(_serverSelectedAccountQB);
        }


        function determinarTipoDocumento(monto, tipoCuenta) {
            const esDebito = monto < 0;
            const esCredito = monto > 0;
            const isAmex = esAmex();

            console.log(`🔍 [Resultados.cshtml] Determinando tipo:`, {
                monto,
                tipoCuenta,
                esDebito,
                esCredito,
                isAmex,
                cuentaQB: _serverSelectedAccountQB
            });

            // ===================================
            // CASO 1: CUENTA BANCARIA (atBank)
            // ===================================
            if (tipoCuenta === 'atBank') {
                if (esCredito) {
                    console.log('✅ Cuenta Bancaria + Crédito → Deposit');
                    return 'Deposit';  // Créditos → Depósitos
                } else {
                    console.log('✅ Cuenta Bancaria + Débito → Check');
                    return 'Check';    // Débitos → Cheques
                }
            }

            // ===================================
            // CASO 2: TARJETA DE CRÉDITO (atCreditCard)
            // ===================================
            if (tipoCuenta === 'atCreditCard') {
                // ✅ LÓGICA AMEX: INVERTIDA
                // Para AMEX, los créditos (positivos) son cargos
                // y los débitos (negativos) son créditos
                if (isAmex) {
                    if (esCredito) {
                        console.log('✅ AMEX + Crédito → CreditCardCharge (invertido)');
                        return 'CreditCardCharge';  // Créditos → Cargos (AMEX invertido)
                    } else {
                        console.log('✅ AMEX + Débito → CreditCardCredit (invertido)');
                        return 'CreditCardCredit';  // Débitos → Créditos (AMEX invertido)
                    }
                }

                // ✅ LÓGICA ESTÁNDAR (otras tarjetas)
                // Para tarjetas normales, débitos (negativos) son cargos
                // y créditos (positivos) son créditos
                if (esDebito) {
                    console.log('✅ Tarjeta + Débito → CreditCardCharge');
                    return 'CreditCardCharge';  // Débitos → Cargos
                } else {
                    console.log('✅ Tarjeta + Crédito → CreditCardCredit');
                    return 'CreditCardCredit';  // Créditos → Créditos
                }
            }

            // ===================================
            // FALLBACK (asume tarjeta de crédito)
            // ===================================
            console.warn('⚠️ Tipo de cuenta desconocido, usando fallback');
            return esDebito ? 'CreditCardCharge' : 'Deposit';
        }

        /**
         * ✅ Obtiene la clase CSS para el badge según el tipo de documento
         * ⚠️ COLORES ACTUALIZADOS SEGÚN LA LÓGICA AMEX
         */
        function obtenerClaseTipoDocumento(tipoDocumento) {
            switch(tipoDocumento) {
                case 'Deposit':
                    return 'tipo-documento-badge tipo-deposit';      // Verde
                case 'Check':
                    return 'tipo-documento-badge tipo-check';        // Amarillo
                case 'CreditCardCharge':
                    return 'tipo-documento-badge tipo-charge';       // Rojo (cargos)
                case 'CreditCardCredit':
                    return 'tipo-documento-badge tipo-credit';       // Azul (créditos)
                default:
                    return 'tipo-documento-badge';
            }
        }

        /**
         * ✅ Actualiza los tipos de documento de todas las filas según el tipo de cuenta
         */
        function actualizarTiposDocumento() {
            const tipoCuenta = sessionStorage.getItem('cuentaQB_Tipo') || 'atCreditCard';

            console.log('📋 [Resultados.cshtml] Actualizando tipos de documento para cuenta tipo:', tipoCuenta);
            console.log('🏦 Cuenta seleccionada:', _serverSelectedAccountQB);
            console.log('🎯 Es AMEX:', esAmex());

            let contador = 0;
            const resumen = {
                Deposit: 0,
                Check: 0,
                CreditCardCharge: 0,
                CreditCardCredit: 0
            };

            $('#resultados-table tbody tr').each(function() {
                const $row = $(this);
                const monto = parseFloat($row.data('monto')) || 0;
                const $tipoCell = $row.find('td[data-tipo-calculado]');
                const $tipoDisplay = $tipoCell.find('.tipo-documento-display');

                // Determinar tipo de documento
                const tipoCalculado = determinarTipoDocumento(monto, tipoCuenta);

                // Obtener clase CSS para el badge
                const claseCSS = obtenerClaseTipoDocumento(tipoCalculado);

                // Actualizar visualización con badge
                $tipoDisplay
                    .text(tipoCalculado)
                    .removeClass()
                    .addClass(claseCSS);

                // Actualizar atributos
                $tipoCell.attr('data-tipo-calculado', tipoCalculado);
                $tipoCell.attr('data-sort-value', tipoCalculado);

                // Guardar en el row data para uso posterior
                $row.data('tipo-documento', tipoCalculado);

                // Contadores para resumen
                resumen[tipoCalculado] = (resumen[tipoCalculado] || 0) + 1;
                contador++;
            });

            console.log(`✅ ${contador} tipos de documento actualizados`);
            console.log('📊 Resumen por tipo:', resumen);
        }

        // ===============================
        //  INICIALIZACIÓN
        // ===============================
        $(document).ready(function () {
            console.log('🚀 Inicializando Resultados.cshtml');
            console.log('📦 Datos del servidor:', {
                bankName: _serverBankName,
                batchId: _serverBatchId,
                selectedAccountQB: _serverSelectedAccountQB,
                interestCharged: _serverInterestCharged,
                esAmex: esAmex()
            });

            // Actualizar tipos de documento al cargar
            actualizarTiposDocumento();

            // ✅ Agregar listener para cuando cambie la cuenta QB
            // (si el usuario cambia de cuenta sin recargar la página)
            $(document).on('cuentaQBChanged', function() {
                console.log('🔄 Cuenta QB cambió, actualizando tipos de documento...');
                actualizarTiposDocumento();
            });

            // Botón guardar proceso
            $('#btn-guardar-proceso').on('click', function () {
                guardarProceso();
            });
        });

        // ===============================
        //  GUARDAR PROCESO
        // ===============================
        async function guardarProceso() {
            const batchId = _serverBatchId || '';
            const bankName = _serverBankName || '';
            const selectedAccountQB = _serverSelectedAccountQB || '';
            const interestCharged = (typeof _serverInterestCharged === 'number') ? _serverInterestCharged : parseFloat(_serverInterestCharged || 0);
            const empresaNombre = '@ViewBag.EmpresaQBName' || 'Empresa';

            console.log("📋 [GuardarProceso] Datos:", {
                empresaNombre,
                batchId,
                bankName,
                selectedAccountQB,
                interestCharged
            });

            if (!batchId) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se encontró el ID del batch'
                });
                return;
            }

            // ===================================
            // RECOLECTAR MOVIMIENTOS DE LA TABLA
            // ===================================
            const movimientos = [];
            $('#resultados-table tbody tr').each(function () {
                const $row = $(this);
                const index = $row.data('index');
                const monto = parseFloat($row.data('monto')) || 0;
                const fecha = $row.find('td:eq(1)').text().trim();
                const empresa = $row.find('.empresa-input').val() || '';
                const descripcion = $row.find('.descripcion-cell').text().trim();
                const cuenta = $row.data('cuenta') || '';

                // ✅ OBTENER EL TIPO DE DOCUMENTO CALCULADO
                const tipoDocumento = $row.data('tipo-documento') ||
                                     $row.find('td[data-tipo-calculado]').attr('data-tipo-calculado') ||
                                     'CreditCardCharge';

                const txnId = $row.find('.txn-id-cell').text().trim();

                // Calcular débito/crédito
                const debito = monto < 0 ? Math.abs(monto) : 0;
                const credito = monto > 0 ? monto : 0;

                movimientos.push({
                    Fecha: fecha,
                    Empresa: empresa,
                    Descripcion: descripcion,
                    Monto: monto,
                    Debito: debito,
                    Credito: credito,
                    CuentaPredicha: cuenta,
                    CuentaAplicada: $row.data('applied-account') || cuenta,
                    TipoDocumento: tipoDocumento,  // ✅ USAR EL TIPO CALCULADO
                    TxnIdQuickBooks: txnId || null,
                    ScorePrediccion: 0
                });
            });

            // ===================================
            // MOSTRAR CONFIRMACIÓN
            // ===================================
            const result = await Swal.fire({
                title: '💾 Guardar Proceso',
                html: `
                    <div style="text-align: left;">
                        <p><strong>Empresa:</strong> ${empresaNombre}</p>
                        <p><strong>Banco:</strong> ${bankName || 'N/A'}</p>
                        <p><strong>Cuenta QB:</strong> ${selectedAccountQB || 'N/A'}</p>
                        <p><strong>Interest Charged:</strong> $${(Number(interestCharged) || 0).toFixed(2)}</p>
                        <p><strong>Total movimientos:</strong> ${movimientos.length}</p>
                    </div>
                    <hr>
                    <p>¿Deseas guardar este proceso en la base de datos?</p>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '✅ Sí, guardar',
                cancelButtonText: '❌ Cancelar',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545'
            });

            if (!result.isConfirmed) {
                return;
            }

            // ===================================
            // MOSTRAR LOADING
            // ===================================
            Swal.fire({
                title: 'Guardando...',
                html: 'Por favor espera mientras se guarda el proceso',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                // Get anti-forgery token
                const antiForgeryInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const antiForgeryToken = antiForgeryInput ? antiForgeryInput.value : null;

                const response = await fetch('/PdfNew/GuardarProceso', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        ...(antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {})
                    },
                    body: JSON.stringify({
                        BatchId: batchId,
                        Banco: bankName,
                        CuentaQB: selectedAccountQB,
                        SaldoInicial: interestCharged,
                        EmpresaNombre: empresaNombre,
                        Movimientos: movimientos
                    })
                });

                let data = null;
                try {
                    data = await response.json();
                } catch (jsonErr) {
                    console.error('Respuesta no JSON:', jsonErr);
                    throw new Error('Respuesta inesperada del servidor');
                }

                if (response.ok && data && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: '✅ Proceso Guardado',
                        html: `
                            <p>El proceso ha sido guardado exitosamente.</p>
                            <p><strong>ID:</strong> ${data.procesoId}</p>
                            <p><strong>${data.updated ? 'Actualizado' : 'Creado'}</strong></p>
                        `,
                        confirmButtonText: 'Aceptar'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: (data && data.message) ? data.message : 'Error al guardar el proceso'
                    });
                }
            } catch (error) {
                console.error('Error guardando proceso:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error de comunicación con el servidor'
                });
            }
        }
    </script>
}


