@section Scripts {
	<script>
			document.getElementById("tipoTerceroSelect").addEventListener("change", function () {
				document.getElementById("formFiltro").submit();
			});

			const today = new Date();
			const formattedDate = today.toISOString().split('T')[0];
			$('#fechaServicio, #pagofecha, #Fec1, #Fec2').val(formattedDate);

				let selectedRow = null;

			document.addEventListener('DOMContentLoaded', function () {
				const contextMenu = document.getElementById('contextMenu');
				const contextPaciente = document.getElementById('contextMenuPaciente');

				document.querySelectorAll('table tbody tr').forEach(row => {
					row.addEventListener('contextmenu', function (e) {
						e.preventDefault();
						selectedRow = this;

						const nombre = selectedRow.dataset.nombre || 'Paciente';
						contextPaciente.innerText = nombre;

						contextMenu.style.top = `${e.pageY}px`;
						contextMenu.style.left = `${e.pageX}px`;
						contextMenu.style.display = 'block';
					});
				});

				document.addEventListener('click', function () {
					contextMenu.style.display = 'none';
				});
			});


					// ✅ Variable general (global en este archivo JS)




		let idTerceroSeleccionado = null;
			window.seleccionarActividad = function (actividad) {
				if (!selectedRow) return;

				const nombre = selectedRow.dataset.nombre || "Paciente";
				const cedula = selectedRow.dataset.nid || "N/A";
				const idTercero = selectedRow.dataset.idtercero || "N/A";

		console.log("Estoy Tomando el ID");
					// ✅ Guardar en variable global
			idTerceroSeleccionado = parseInt(idTercero);

					if (actividad === 'actividad1') {
											// Redirigir a la misma URL que el botón habría enlazado
						window.location.href = `/Terceros/TercerosDet?id=${idTercero}`;
					}

				if (actividad === 'actividad2') {
					document.getElementById('buscarModalLabel').innerText = `${nombre} - NID: ${cedula}`;
					// Search for accounting code
		fetch(`/terceros/ModeloTerceros?id=${cedula}`)
			.then(response => {
				if (!response.ok) throw new Error("Error al obtener datos del servidor");
				return response.json(); // 👈 Interpretar la respuesta como JSON
			})
			.then(data => {

				console.log("Data:", data.terConPoliza);

				let seguro = document.getElementById('checkSeguro');

			if (seguro) {
				// Si data.terConPoliza es verdadero (true), se marca el checkbox
				seguro.checked = data.terConPoliza === true || data.terConPoliza === "true" || data.terConPoliza === 1 || data.terConPoliza === "1";
				console.log("Sí lo encontré", data.terConPoliza);
			} else {
				console.log("No lo encontré");
			}
					 document.getElementById('numeroPoliza').value =  data.terPoliza || "";
					// document.getElementById('vencimientoPoliza').value =  data.terPolFecVen || "";

					document.getElementById('TerPhone').value = data.phone || ""; // o data.Phone si la propiedad tiene P mayúscula

					document.getElementById('TerEmail').value = data.email || ""; // o data.Phone si la propiedad tiene P mayúscula

						console.log("Estoy donde veo",data.estudios);

							// Almacena la lista de estudios globalmente para usar luego
				window.listaEstudios = data.estudios || [];
				window.listaMedicos = data.medicos || [];
				window.tipoPagoLista = data.listaTPagos || [];
				console.log("Datos recibidos:", data);


					// document.getElementById('selectSeguros').value = data.terPolComId || ""; // o data.Phone si la propiedad tiene P mayúscula





					// Llenar select de direcciones
						const select = document.getElementById('selectDirecciones');
						select.innerHTML = ''; // Limpiar opciones anteriores
								data.direcciones.forEach(dir => {
									const option = document.createElement('option');
									option.value = dir.value;
									option.textContent = dir.text;
										if (dir.value === data.idDirection) {
											option.selected = true; // Seleccionar la que estaba guardada
										}
										select.appendChild(option);
								});

								console.log("Lista de Seguros 1",data.seguros);

								// Llenar select de seguros
								const selectSeguros = document.getElementById('selectSeguros');
								selectSeguros.innerHTML = ''; // Limpiar

								const defaultOption = document.createElement('option');
								defaultOption.value = '';
								defaultOption.textContent = '-- Seleccionar --';
								selectSeguros.appendChild(defaultOption);

								let haySeleccion = false;
								const idSeleccionado = String(data.terPolComId).trim();

								data.seguros.forEach(seg => {
									const option = document.createElement('option');
									option.value = seg.value;
									option.textContent = seg.text;

									if (String(seg.value).trim() === idSeleccionado) {
										option.selected = true;
										haySeleccion = true;
									}

									selectSeguros.appendChild(option);
								});

			if (!haySeleccion) {
				selectSeguros.value = '';
			}



				 // const primerElemento = data.Phone;
				 // console.log("Datos recibidos:", primerElemento);


				// Aquí ya puedes acceder a data.Name, data.Email, etc.
			})
			.catch(error => {
				console.error('Error fetching data:', error);
			});






					const modal = new bootstrap.Modal(document.getElementById('buscarModal'));
					modal.show();
				}

				document.getElementById('contextMenu').style.display = 'none';
			};


			function ajustarScrollDinamico() {
				const tbody = document.getElementById("facturacionTableBody");
				const container = document.getElementById("tbodyContainer");
				const filas = tbody.getElementsByTagName("tr");

				if (filas.length > 4) {
					const alturaFila = filas[0].offsetHeight || 22; // fallback si aún no renderiza
					container.style.maxHeight = (alturaFila * 4) + "px";
					container.style.overflowY = "auto";
