		function obtenerDetallesFactura() {
						console.log("🚀 obtenerDetallesFactura se ejecuta");
				const detalles = [];

		document.querySelectorAll("#facturacion1TableBody tr").forEach(fila => {
			const celdas = fila.querySelectorAll("td");

			const selectMedTec = fila.querySelector('.medTecSelect');
			const detFacMedTec = selectMedTec && selectMedTec.value !== ""
				? parseInt(selectMedTec.value)
				: 0;

			const detalle = {
				detFacEstudioId: parseInt(celdas[0].textContent.trim()),
				detFacPrecio: limpiarNumero(celdas[2].querySelector('input')?.value || '0'),
				detFacCantidad: parseInt(celdas[3].querySelector('input')?.value || '0'),
				detFacTotal: limpiarNumero(celdas[4].querySelector('input')?.value || '0'),
				detFacCobertura: limpiarNumero(celdas[5].querySelector('input')?.value || '0'),
				detFacDiferencia: limpiarNumero(celdas[6].querySelector('input')?.value || '0'),
				detFacPrivado: limpiarNumero(celdas[7].querySelector('input')?.value || '0'),
				detFacPorcentaje: limpiarNumero(celdas[8].querySelector('input')?.value || '0'),
				detFacMedTec: detFacMedTec,
				detFacPagMed: limpiarNumero(celdas[10].querySelector('input')?.value || '0')
			};

			detalles.push(detalle);
		});


			return detalles;
		}

