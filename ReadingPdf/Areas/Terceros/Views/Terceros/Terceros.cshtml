@model DataPaginador<InputModelTerceros>
@{
	ViewData["Title"] = "Terceros";

}
<style>
	#tablaPrecios thead th {
		position: sticky;
		top: 0;
		background-color: #f5f5f5; /* Puedes cambiar el color de fondo según tu preferencia */
		z-index: 1;
	}

	#tablaPrecios tfoot td {
		position: sticky;
		bottom: 0;
		background-color: #f5f5f5; /* Puedes cambiar el color de fondo según tu preferencia */
		z-index: 1;
	}


	.btn-img {
		width: 64px; /* Tamaño del botón */
		height: 64px;
		padding: 0; /* Elimina el relleno del botón */
		border: none; /* Opcional: Elimina el borde */
		background: none; /* Elimina el color de fondo */
	}

	.btn-img1 {
		width: 40px; /* Tamaño del botón */
		height: 40px;
		padding: 0; /* Elimina el relleno del botón */
		border: none; /* Opcional: Elimina el borde */
		background: none; /* Elimina el color de fondo */
	}

	.btn-img img {
		width: 100%; /* La imagen ocupará todo el botón */
		height: 100%;
	}

	.btn-img1 img {
		width: 100%; /* La imagen ocupará todo el botón */
		height: 100%;
	}

	/* Estilos personalizados para cambiar el tamaño del modal */
	.modal-xl-custom {
		max-width: 30%; /* Cambia este valor para ajustar el ancho */
		height: 30vh; /* Cambia este valor para ajustar la altura */
	}

	.modal-content-custom {
		height: 100%; /* Hace que el contenido ocupe toda la altura disponible */
	}

	.tabla-precios {
		font-size: 11px;
		font-family: 'Open Sans Condensed', sans-serif;
		line-height: 20px;
	}


	.custom-context-menu {
		position: absolute;
		z-index: 1050;
		display: none;
		background-color: white;
		border: 1px solid #ccc;
		box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.2);
		border-radius: 0.25rem;
		min-width: 200px;
		padding: 0.5rem 0;
	}

		.custom-context-menu a {
			display: block;
			padding: 0.25rem 1rem;
			color: #212529;
			text-decoration: none;
		}

			.custom-context-menu a:hover {
				background-color: #f8f9fa;
			}


	.table-sm th,
	.table-sm td {
		padding: 2px 4px !important; /* Reduce espacio horizontal y vertical */
		font-size: 11px; /* Opcional: ajusta el tamaño del texto */
		line-height: 1.2; /* Comprime la altura */
	}

	#facturacionTableBody tr {
		height: 22px !important; /* Forzar menor altura por fila (opcional) */
	}

</style>
<div class="container">
	<div class="row">
		<div class="col-9">
			<h1 class="text-center">Catálogo de Terceros</h1>
		</div>

		<div class="col-3">
			<h1>
				<a class="btn btn-success btn-img"
				   asp-route-id=""
				   asp-area="Clientes"
				   asp-controller="Home"
				   asp-action="Clientes"
				   title="Importar desde Excel">
					<img src="/images/excel_import_icon_141930.png" alt="Guardar" width="64" height="64">
				</a>
				<a class="btn btn-success btn-img"
				   asp-route-id=""
				   asp-area="Clientes"
				   asp-controller="Clientes"
				   asp-action="ExportarExcel"
				   title="Exportar a Excel">
					<img src="/images/excel_export_icon_141930.png" alt="Guardar" width="64" height="64">
				</a>
				<a class="btn btn-success btn-img"
				   href="#"
				   data-bs-toggle="modal"
				   data-bs-target="#buscarModal"
				   title="Abrir modal de búsqueda">
					<img src="/images/excel_export_icon_141930.png" alt="Buscar" width="64" height="64">
				</a>


				<a class="btn btn-success btn-img"
				   asp-route-id="0"
				   asp-area="Terceros"
				   asp-page="/Account/TercerosReg"
				   title="Agregar Nuevo Tercero">
					<img src="/images/add_terceros_icon_141930.png" alt="Guardar" width="64" height="64">
				</a>
			</h1>
		</div>
	</div>
	@* 	<form asp-area="Terceros" asp-controller="Terceros" asp-action="Terceros" method="get"> *@
	<form id="formFiltro" asp-area="Terceros" asp-controller="Terceros" asp-action="Terceros" method="get">

		<div class="form-row">
			<div class="row align-items-center">
				<div class="col-5 pr-0">
					<input type="text" id="filtrar" name="filtrar" placeholder="Buscar" class="form-control" />
				</div>
				<div class="col-2 pl-1">
					<button type="submit" class="btn btn-success btn-img1" title="Buscar Tercero">
						<img src="/images/search_look_for_find_locate_magnifying_glass_lens_icon_141939.webp" alt="Buscar" width="32" height="32">
					</button>
				</div>
			</div>

		</div>
	</form>

	<div class="row mt-2">
		<table class="table" style="font-size: 12px; height: 20px; font-family: 'Open Sans Condensed', sans-serif;">
			<thead>
				<tr>
					<th scope="col">Nro. Documento</th>
					<th scope="col">Nombres y Apellidos</th>
					<th scope="col">Nombre Comercial</th>
					<th scope="col">Tipo Persona
					<th scope="col">Tipo Tercero</th>
				</tr>
			</thead>
			<tbody class="align-content-md-start">
				@foreach (var item in Model.List)
				{
					<tr data-nid="@item.Nid" data-nombre="@item.Name" data-idtercero="@item.IdTercero">
						<td class="col-1">@Html.DisplayFor(modelItem => item.Nid)</td>
						<td class="col-3">@Html.DisplayFor(modelItem => item.Name)</td>
						<td class="col-3">@Html.DisplayFor(modelItem => item.NombreComercial)</td>
						<td class="col-1">@Html.DisplayFor(modelItem => item.NombreTipoTercero)</td>
						<td class="col-2">@Html.DisplayFor(modelItem => item.NombreTipTercero)</td>
						@* 						<td>
							<a class="btn-elimina btn-success" asp-route-id="@item.IdTercero" asp-area="Terceros"
							   asp-page="/Account/TercerosDet"><i class="fas fa-pen"></i> </a>
						</td>
						<td>
							<a class="btn-elimina btn-success" data-bs-toggle="modal" data-bs-target="#buscarModal"><i class="fas fa-pen"></i> </a>
						</td> *@
						@* 						<a class="btn-elimina btn-success" asp-route-id="@item.IdTercero" asp-area="Terceros"
						   asp-page="/Account/TercerosDet"><i class="fas fa-pen"></i> </a>
						</td>

						<button class="btn btn-success btn-img" data-bs-toggle="modal" data-bs-target="#buscarModal">
							<img src="/images/previous_arrow_left_icon_141936.png" alt="Buscar" width="64" height="64">
						</button> *@

					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

<div class="text-center">
	Resultados @Html.Raw(Model.Pagi_info);
	<br />
	@Html.Raw(Model.Pagi_navegacion)
</div>

<!-- Modal -->
<div class="modal fade" id="accionModal" tabindex="-1" aria-labelledby="accionModalLabel" aria-modal="true" role="dialog">
	@* <form id="formModal" method="post"> *@
	<div class="modal-dialog modal-xl-custom">
		<div class="modal-content modal-content-custom">
			<div class="modal-header">
				@*   <h5 class="modal-title" id="accionModalLabel">Acción</h5> *@

			</div>

			<button type="button" class="close" data-dismiss="modal" aria-label="Close">
				<span aria-hidden="true">&times;</span>
			</button>
			<div class="modal-body">
				<!-- Aquí va el contenido de la modal -->
				<form id="formModal" asp-action="VerReporte3" asp-controller="HisEstudios" method="get">
					<input type="hidden" name="id" id="terceroIdHidden" value="" />




					<div class="col-md-12 fixed-width-border" style="padding: 0px;">
						<div class="card text-center">
							<div class="card-header">
								<div class="row">
									<div class="input-group mb-3">
										<span class="form-control2">Fec. Desde</span>
										@* <input asp-for="Input.pFechaIni" type="date" class="form-control2" /> *@
										<input type="date" name="fechaInicio" class="form-control2" id="Fec1" />

										<span class="form-control2">Fe. Hasta</span>
										@* 	<input asp-for="Input.pFechaFin" type="date" class="form-control2" /> *@
										<input type="date" name="fechaFin" class="form-control2" id="Fec2" />
									</div>
								</div>
							</div>
						</div>

						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
							<button type="submit" class="btn btn-primary">Aceptar</button>
						</div>
					</div>
				</form>


			</div>
		</div>

	</div>
	@* </form> *@
</div>

