				async function construirFacturaDTO() {

					debugger;

			const tipComprobante = "PF";
			const now = new Date();
			const year = now.getFullYear();
			const month = now.getMonth() + 1;

			let terNumerado = "";
			try {
				const response = await fetch(`/Terceros/Terceros/GetUltimoComprobante?tipo=${tipComprobante}&year=${year}&month=${month}`);
				if (!response.ok) throw new Error("No se pudo obtener el número de comprobante");
				terNumerado = await response.text();
				console.log("📄 TerNumerado generado:", terNumerado);
			} catch (error) {
				console.error("❌ Error obteniendo TerNumerado:", error);
				alert("No se pudo generar el número correlativo.");
				return null;
			}

			return {
				terceroId: parseInt(document.getElementById('IdTercero').value),
				fecha: new Date().toISOString().split("T")[0],
				total: 100000, // ← tu lógica para el total

				terNumerado: terNumerado, // ⬅️ aquí el nuevo campo

				terEmbarazo: document.getElementById('checkEmbarazo').checked,
				terEmergencia: document.getElementById('checkEmergencia').checked,
				terEntregaRec: document.getElementById('checkEntrega').checked,
				terSemanasEmb: parseInt(document.getElementById('numeroSemanas').value || "0"),
				terReferido: document.getElementById('textReferido').value,
				terNcf: document.getElementById('textNfc').value,
				//terValorComp: parseFloat(document.getElementById('TerValorComp').value || "0"),
				terMedCab: parseInt(document.getElementById('selectMedicoCab').value || "0"),
				//terValorComp: parseFloat(document.getElementById('TerValorComp').value || "0"),
				terValorComp: limpiarNumero(document.getElementById('TerValorComp').value || "0"),

				terMedAti: document.getElementById('selectMedicoAti').value,
				//terValReclamo: parseFloat(document.getElementById('Input_TerValReclamo').value || "0"),
				terValReclamo: limpiarNumero(document.getElementById('Input_TerValReclamo').value || "0"),
				//terValPagMed: parseFloat(document.getElementById('Input_TerValPagMed').value || "0"),
				terValPagMed: limpiarNumero(document.getElementById('Input_TerValPagMed').value || "0"),

				detalles: obtenerDetallesFactura()
			};

		}




		function limpiarNumero(nmn) {
			console.log("🔹 Valor antes de limpiar:", nmn);

			if (typeof nmn !== 'string') {
				nmn = String(nmn ?? '');
			}

			// Quitar separador de miles y dejar el decimal
			const limpio = parseFloat(nmn.replace(/,/g, ''));

			console.log("✅ Valor limpio:", limpio);

			return isNaN(limpio) ? 0 : limpio;
		}


