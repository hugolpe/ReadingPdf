<style>
	#tablaDirecciones thead th {
		position: sticky;
		top: 0;
		background-color: #f5f5f5; /* Puedes cambiar el color de fondo según tu preferencia */
		z-index: 1;
	}

	#tablaDirecciones tfoot td {
		position: sticky;
		bottom: 0;
		color: #495057;
		background-color: #e9ecef; /* Color de fondo gris como los campos readonly */
		background-clip: padding-box;
		border: 1px solid #ced4da;
		border-radius: .25rem;
		transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
	}

	.btn-img {
		width: 64px; /* Tamaño del botón */
		height: 64px;
		padding: 0; /* Elimina el relleno del botón */
		border: none; /* Opcional: Elimina el borde */
		background: none; /* Elimina el color de fondo */
	}

	.btn-img1 {
		width: 40px; /* Tamaño del botón */
		height: 40px;
		padding: 0; /* Elimina el relleno del botón */
		border: none; /* Opcional: Elimina el borde */
		background: none; /* Elimina el color de fondo */
	}

	.btn-img img {
		width: 100%; /* La imagen ocupará todo el botón */
		height: 100%;
	}

	.btn-img1 img {
		width: 100%; /* La imagen ocupará todo el botón */
		height: 100%;
	}
	/* Agrega más clases y define el ancho según sea necesario para otras columnas */
	/* Estilos personalizados para cambiar el tamaño del modal */
	.modal-xl-custom {
		max-width: 60%; /* Cambia este valor para ajustar el ancho */
		height: 90vh; /* Cambia este valor para ajustar la altura */
	}

	.modal-content-custom {
		height: 100%; /* Hace que el contenido ocupe toda la altura disponible */
	}

	.modal-xl-custom1 {
		max-width: 40%; /* Cambia este valor para ajustar el ancho */
		height: 90vh; /* Cambia este valor para ajustar la altura */
	}

	.modal-content-custom1 {
		height: 100%; /* Hace que el contenido ocupe toda la altura disponible */
	}

	.modal-xl-customp {
		max-width: 40%; /* Cambia este valor para ajustar el ancho */
		height: 70vh; /* Cambia este valor para ajustar la altura */
	}

	.modal-content-customp {
		height: 100%; /* Hace que el contenido ocupe toda la altura disponible */
	}

	.form-controly {
		display: block;
		width: 100%;
		height: calc(1.5em + .75rem + -5px);
		padding: .275rem .75rem;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.5;
		color: #495057;
		background-clip: padding-box;
		border: 1px solid #ced4da;
		border-radius: .25rem;
		transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
	}

	.custom-containertd {
		width: 250px;
	}

	.custom-containerfc {
		width: 150px;
	}

	.custom-containerfc1 {
		width: 150px;
	}

	.custom-containerdes {
		width: 550px;
	}


	.card-body {
		-ms-flex: 1 1 auto;
		flex: 1 1 auto;
		padding: 2rem;
	}

	.fixed-height-card-body {
		height: 352px;
	}

	.card-bodyp {
		-ms-flex: 1 1 auto;
		flex: 1 1 auto;
		padding: 2rem;
	}
