		function guardarDetallePrestacion() {
			const codigo = document.getElementById('modalCodigoPrestacion').value;
			const nombre = document.getElementById('modalNombrePrestacion').value;
			const precio = document.getElementById('modalPrecioPrestacion').value;

			if (!precio || isNaN(precio)) {
				alert("Por favor ingresa un precio válido.");
				return;
			}

			const tablaDerecha = document.getElementById('cuerpoTablaDerecha');
			const fila = document.createElement('tr');
			fila.innerHTML = `
				<td></td>
				<td>${codigo}</td>
				<td>${nombre}</td>
				<td>${parseFloat(precio).toFixed(2)}</td>
			`;
			tablaDerecha.appendChild(fila);

			$('#modalDetallePrestacion').modal('hide');
		}



