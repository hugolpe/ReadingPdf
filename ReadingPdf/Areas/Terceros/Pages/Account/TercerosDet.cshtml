                              function eliminarDireccion(index) {
                                  var tableBody = document.getElementById("direccionesTableBody");
                                  tableBody.deleteRow(index);

                                  direccionIndex--; // decrementamos porque quitamos una fila

                                  var rows = tableBody.getElementsByTagName("tr");



                                  for (var i = 0; i < rows.length; i++) {
                                      var row = rows[i];



                                      row.getElementsByTagName("td")[0].textContent = i + 1;

                              const loco = row.getElementsByTagName("td")[0].textContent = i + 1;




                                      // Reasignar correctamente los IDs y Names
                                      var dirDescripInput = row.querySelector('input[name^="Direccion["][name$="].DirDescrip"]');

                                      var direccionInput = row.querySelector('input[name^="Direccion["][name$="].Direccion"]');
                                      var codCiudadSelect = row.querySelector('select[name^="Direccion["][name$="].CodCiudad"]');
                                      var hiddenInput = row.querySelector('input[type="hidden"][name^="Direccion["][name$="].IdDirection"]');
                                      var deleteButton = row.querySelector('button');

                                      if (dirDescripInput) {

                                          dirDescripInput.name = `Direccion[${i}].DirDescrip`;
                                          dirDescripInput.id = `DirDescrip${i}`;
                                      }
                                      if (direccionInput) {
                                          direccionInput.name = `Direccion[${i}].Direccion`;
                                          direccionInput.id = `Direccion${i}`;
                                      }
                                      if (codCiudadSelect) {
                                          codCiudadSelect.name = `Direccion[${i}].CodCiudad`;
                                          codCiudadSelect.id = `CodCiudad${i}`;
                                      }
                                      if (hiddenInput) {
                                          hiddenInput.name = `Direccion[${i}].IdDirection`;
                                          hiddenInput.id = `HiddenDirection${i}`;
                                      }
                                      if (deleteButton) {
                                          deleteButton.setAttribute('onclick', `eliminarDireccion(${i})`);
                                      }
                                  }
                              }





