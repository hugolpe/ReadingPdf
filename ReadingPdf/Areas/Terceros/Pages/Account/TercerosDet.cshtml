                const input = document.getElementById(`VrPago${index}`);
                if (input) {
                    input.value = numero.toLocaleString('en-US', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            }
actualizarTotalP();
        }



